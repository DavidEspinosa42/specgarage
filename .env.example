# SpecGarage runtime configuration. Copy to `.env` to override the defaults.
# None of these values is a secret; the application needs no credentials.

# Directory holding the SQLite database and stored evidence/document files.
SPECGARAGE_DATA_DIR=./data

# Port for `specgarage serve`. The server always binds to 127.0.0.1.
SPECGARAGE_PORT=8787

# Largest accepted upload (one file), in megabytes.
SPECGARAGE_MAX_UPLOAD_MB=15
