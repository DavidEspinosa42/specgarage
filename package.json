{
  "name": "specgarage",
  "version": "0.0.0",
  "private": true,
  "description": "Offline technical preparation and compliance documentation for single-make racing categories.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "specgarage": "node src/cli/main.ts",
    "start": "node src/cli/main.ts serve",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "zod": "4.6.7"
  }
}
